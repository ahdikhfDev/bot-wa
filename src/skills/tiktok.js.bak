import { hasCookies, uploadVideo, getLoginQR, closeBrowser } from '../services/tiktok.js';
import fs from 'fs';
import path from 'path';

const LAST_VIDEO_KEY = 'last_video_path';

export default {
  name: 'tiktok',
  title: 'TikTok Upload',
  description: 'Upload video ke TikTok via /tt [caption]',
  commands: ['tt', 'tiktok', 'logintiktok', 'login-tiktok'],

  async handler(sock, remoteJid, args, context) {
    const cmd = args[0]?.toLowerCase() || '';

    // Login command
    if (['logintiktok', 'login-tiktok', 'login'].includes(cmd)) {
      await sock.sendMessage(remoteJid, { text: '⏳ Membuka halaman login TikTok...' });

      const result = await getLoginQR();
      if (result.error) {
        await sock.sendMessage(remoteJid, { text: `❌ ${result.error}` });
        return;
      }

      if (result.alreadyLoggedIn) {
        await sock.sendMessage(remoteJid, { text: '✅ Kamu sudah login TikTok!' });
        return;
      }

      if (result.qrImage) {
        // Send QR as image
        const imgBuf = Buffer.from(result.qrImage.replace(/^data:image\/\w+;base64,/, ''), 'base64');
        const tmpPath = '/tmp/tiktok-login-qr.png';
        fs.writeFileSync(tmpPath, imgBuf);

        await sock.sendMessage(remoteJid, {
          image: fs.readFileSync(tmpPath),
          caption: '📱 Scan QR ini dengan TikTok kamu (lewat menu scanner di TikTok)',
        });
        fs.unlinkSync(tmpPath);

        // Wait, then check if login succeeded
        await sock.sendMessage(remoteJid, { text: '⏳ Menunggu login... Setelah scan, kirim /logintiktok lagi untuk verifikasi.' });

        setTimeout(async () => {
          try {
            await result.page?.close();
            await closeBrowser();
          } catch {}
        }, 120000);
      }

      return;
    }

    // Upload command: /tt [caption] or /tiktok [caption]
    if (!hasCookies()) {
      await sock.sendMessage(remoteJid, { text: '❌ Belum login TikTok. Kirim /logintiktok dulu.' });
      return;
    }

    // Get the video file to upload
    const caption = args.join(' ') || '';

    // Check if user provided a custom path or use last generated video
    let videoPath = null;

    // Check args for file path
    for (const arg of args) {
      if (fs.existsSync(arg)) {
        videoPath = arg;
        break;
      }
    }

    // If no path in args, check for last generated video
    if (!videoPath) {
      const lastVideo = global[LAST_VIDEO_KEY];
      if (lastVideo && fs.existsSync(lastVideo)) {
        videoPath = lastVideo;
      } else {
        // Try to find newest video in tmp
        const tmpDir = '/tmp';
        const files = fs.readdirSync(tmpDir)
          .filter(f => f.endsWith('.mp4') && f.startsWith('thirty-video'))
          .sort()
          .reverse();
        if (files.length > 0) {
          videoPath = path.join(tmpDir, files[0]);
        }
      }
    }

    if (!videoPath || !fs.existsSync(videoPath)) {
      await sock.sendMessage(remoteJid, { text: '❌ Tidak ada video untuk diupload. Bikin dulu pake /buatvideo.' });
      return;
    }

    await sock.sendMessage(remoteJid, {
      text: `⏳ Mengupload video ke TikTok...\n📹 ${path.basename(videoPath)}\n📝 Caption: ${caption || '(kosong)'}\n⏱️ Ini bisa sampai 2 menit...`,
    });

    const result = await uploadVideo(videoPath, caption);

    if (result.error) {
      await sock.sendMessage(remoteJid, { text: `❌ Gagal upload: ${result.error}` });
      return;
    }

    if (result.success) {
      await sock.sendMessage(remoteJid, { text: '✅ Video berhasil diupload ke TikTok! 🎉' });
    } else {
      await sock.sendMessage(remoteJid, { text: '⚠️ Upload selesai, tapi status tidak pasti. Cek TikTok kamu.' });
    }
  },
};

// Store last video path globally when video is created
export function setLastVideoPath(filePath) {
  global[LAST_VIDEO_KEY] = filePath;
}
