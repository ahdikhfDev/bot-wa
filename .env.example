# ============================================
# Thirty Bot — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# --- AI Provider: Groq (Primary) ---
# Daftar gratis di https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- AI Provider: Google Gemini (Fallback) ---
# Daftar di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- AI Provider: Anthropic Claude (Fallback) ---
# Daftar di https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- AI Provider: 9Router (Fallback) ---
9ROUTER_API_KEY=
ROUTER_BASE_URL=https://ai.akf.biz.id/v1
ROUTER_MODEL=qwen2-vl-72b

# --- Default AI Provider ---
# Options: groq, gemini, anthropic, 9router
AI_PROVIDER=groq

# --- Web Search ---
# Daftar gratis di https://tavily.com
TAVILY_API_KEY=

# --- News API ---
# Daftar gratis di https://gnews.io
GNEWS_API_KEY=

# --- WhatsApp Owner ---
# Nomor HP owner (628xxx, tanpa +)
OWNER_NUMBER=6281234567890
# WhatsApp LID (optional)
OWNER_LID=
# Multi-owner (optional, comma-separated)
OWNER_IDS=

# --- Bot Settings ---
BOT_PREFIX=/
BOT_NAME=Thirty
GROUP_CONTEXT_ENABLED=true
MAX_CONTEXT_MESSAGES=20
SPAM_COOLDOWN_MS=1500
MAX_TEXT_LENGTH=4096
MAX_INBOUND_MEDIA_BYTES=12582912
OUTBOUND_MIN_DELAY_MS=1200
OUTBOUND_JITTER_MS=800
RECONNECT_DELAY_MS=5000

# --- Database ---
DB_PATH=./data/database.sqlite

# --- Web Dashboard ---
WEB_PORT=6789
WEB_DASHBOARD_INIT_PASSWORD=change_this_password

# --- Logging ---
LOG_LEVEL=info

# --- Public Stock Downloads ---
PUBLIC_STOCK_DOWNLOADS=true

# --- Deployment (deploy.js) ---
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_PASSWORD=
DEPLOY_PRIVATE_KEY_PATH=
DEPLOY_REMOTE_DIR=
DEPLOY_ARCHIVE=bot.tar.gz
