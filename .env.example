# WhatsApp Bot Environment Configuration

# Groq API Configuration (Free)
GROQ_API_KEY=gsk_
GROQ_MODEL=

# Database
DB_PATH=./src/database.sqlite

# Bot Configuration
BOT_NAME=Thirty
BOT_PREFIX=/
OWNER_NUMBER=62...
AUTO_REPLY=false
GROUP_CONTEXT_ENABLED=true
MAX_CONTEXT_MESSAGES=20
SPAM_COOLDOWN_MS=1500

# Logging
LOG_LEVEL=info

# News API (Optional — untuk cari berita real-time)
# Daftar gratis di https://gnews.io
GNEWS_API_KEY=

# Web Search API (Optional — biar bisa search general & terbaru)
# Rekomendasi: Tavily (1000 gratis/bulan, hasil kayak Google beneran)
# Daftar 1 menit di https://tavily.com → copy API key
TAVILY_API_KEY=

# Dashboard security
WEB_DASHBOARD_INIT_PASSWORD=password_kuat_disini
PUBLIC_STOCK_DOWNLOADS=true

# Deploy script (deploy.js)
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_PASSWORD=
DEPLOY_PRIVATE_KEY_PATH=
DEPLOY_REMOTE_DIR=/root/thirty-bot
DEPLOY_ARCHIVE=bot.tar.gz
